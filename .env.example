# Skopiuj ten plik jako .env i wstaw swój klucz z https://console.groq.com/keys
GROQ_API_KEY=gsk_wstaw_tutaj_swoj_klucz

# Opcjonalnie możesz wybrać inny aktywny model Groq.
GROQ_MODEL=llama-3.3-70b-versatile

# Domyślnie logowane są tylko metadane. Ustaw true wyłącznie do lokalnego debugowania treści.
GROQ_LOG_CONTENT=false

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Wyłącznie dla lokalnych skryptów administracyjnych. Nigdy nie używaj w frontendzie.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key
